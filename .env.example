# =================================================================
# Configurações de Ambiente - InfoTech Gestão / Power Tech
# =================================================================

# Modo de execução (production para VPS / servidor online)
NODE_ENV=production

# Porta interna do servidor Node.js (geralmente atrás do Nginx reverso)
PORT=4567

# Domínio público ou URL oficial do sistema (usado para links de WhatsApp e rastreamento)
# Exemplo: https://sistema.minhaloja.com.br ou https://os.minhaloja.com.br
APP_URL=https://sistema.minhaloja.com.br

# Chave secreta criptográfica para assinatura dos tokens JWT da sessão administrativa
# GERE UMA CHAVE FORTE DE 64 CARACTERES EM PRODUÇÃO (ex: via `openssl rand -hex 32`)
JWT_SECRET=coloque_uma_chave_criptografica_muito_segura_aqui_com_no_minimo_32_caracteres

# Senha inicial do usuário 'admin' (utilizada somente se for a primeira inicialização)
INITIAL_ADMIN_PASSWORD=DefinaUmaSenhaForteParaOAdminAqui!2026

# Diretório persistente para armazenamento do banco de dados (database.json)
# No Linux VPS recomendado: /var/data/infotech ou ./data
DATA_DIR=/var/data/infotech

# Diretório de destino para os backups diários automáticos
# No Linux VPS recomendado: /var/backups/infotech
BACKUP_DIR=/var/backups/infotech

# Desativa o Cloudflare Quick Tunnel em produção (o tráfego deve vir via Nginx + SSL próprio)
ENABLE_CLOUDFLARE_TUNNEL=false
